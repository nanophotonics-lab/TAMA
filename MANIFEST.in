include LICENSE THIRD_PARTY_NOTICES.txt CITATION.cff README.md CHANGELOG.md
include licenses/GPL-2.0-or-later.txt
include pyproject.toml environment.yml build_native_sampler.sh
recursive-include src/tama *.py *.pyi py.typed LICENSE THIRD_PARTY_NOTICES.txt
graft native/meep
graft docs
graft examples
graft tests
graft .github/workflows
include .readthedocs.yaml
include .gitattributes
prune docs/_build
prune native/meep/build
prune native/meep/dist
prune native/meep/_skbuild
global-exclude __pycache__ *.py[cod] *:Zone.Identifier
global-exclude *.so *.pyd *.o *.whl
